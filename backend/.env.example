DB_HOST=biomedical-maintenance-db.c9o8kaiim0dv.ca-central-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=biomedical_maintenance
DB_USER=postgres
DB_PASSWORD=
# Relative paths are resolved from backend/, regardless of launch directory.
DB_SSLROOTCERT=global-bundle.pem

# Run the team's existing AI service separately on port 8001.
AI_SERVICE_URL=http://127.0.0.1:8001

# AI service background scheduling. Disabled unless explicitly set to true.
# Controls the startup overdue sweep and hourly optimization only.
# Manual POST /api/ai/optimize-schedule and equipment CRUD can still write.
SCHEDULER_ENABLED=false
